{
  "hooks": {
    "preToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|TodoWrite",
        "hooks": [
          {
            "type": "command",
            "command": "npx tdd-guard@latest"
          }
        ]
      }
    ],
    "userPromptSubmitted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx tdd-guard@latest"
          }
        ]
      }
    ],
    "sessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "npx tdd-guard@latest"
          }
        ]
      }
    ]
  },
  "version": 1
}
